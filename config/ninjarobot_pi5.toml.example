schema_version = 1

[hardware.buzzer]
enabled = true
gpio = 27

[hardware.servos]
enabled = true
endpoints = ["gpio12", "gpio13"]
calibration_file = "~/.config/pi5servo/servo.json"
motion_enabled = true
group_motion_enabled = true

[hardware.display]
enabled = true
model = "ST7789V"
width = 240
height = 320
spi_bus = 0
spi_device = 0
frequency_hz = 32000000
dc_gpio = 4
reset_gpio = 5
backlight_gpio = 6
rotation = 90
brightness = 75

[hardware.i2c]
bus = 1
dfr0566_address = 16
vl53l0x_address = 41

[hardware.camera]
enabled = true
width = 1280
height = 720
warmup_seconds = 1.0
autofocus_mode = "none"
media_directory = "~/.local/share/ninjarobot_pi5/camera"
retain_media_by_default = false

[hardware.microphone]
enabled = true
device_selector = "USB PnP Sound Device"
sample_rate_hz = 16000
channels = 1
max_capture_seconds = 10.0
media_directory = "~/.local/share/ninjarobot_pi5/microphone"
retain_audio_by_default = false

[behaviors]
user_directory = "~/.config/ninjarobot_pi5/behaviors"
safety_state_file = "~/.local/state/ninjarobot_pi5/safety.json"
left_motor_role = "left_motor"
right_motor_role = "right_motor"
obstacle_threshold_mm = 50
obstacle_consecutive_readings = 3
distance_poll_interval_seconds = 0.05
watchdog_timeout_seconds = 1.0
system_stopped_display_seconds = 2.0
stop_on_invalid_distance = false

[behaviors.servo_roles]
left_motor = "gpio12"
right_motor = "gpio13"

[agent]
default_provider = "ollama"
max_model_turns = 6
max_tool_calls = 8
request_timeout_seconds = 600.0
model_inactivity_timeout_seconds = 120.0
# Optional provider failover is disabled by default. Add configured provider IDs
# only when you accept their network cost and data handling.
fallback_providers = []

[memory]
enabled = true
conversation_retention_days = 7
failed_behavior_retention_days = 180
failed_behavior_cap = 1000
retrieval_limit = 6
retrieval_character_budget = 4000
face_data_directory = "~/.local/share/ninjarobot_pi5/faces"

# Phase 8 release features remain opt-in. Enabling voice does not arm motion.
[voice_input]
enabled = false
model_resource = "package://ninjarobot_pi5_ide/assets/hey_Ninja.onnx"
inference_framework = "onnx"
wake_threshold = 0.5
vad_enabled = true
wake_vad_threshold = 0.3
silence_rms_threshold = 200
noise_suppression_enabled = false
max_command_seconds = 15.0
silence_stop_seconds = 1.25
cooldown_seconds = 1.0
startup_timeout_seconds = 10.0
frame_milliseconds = 80
language = "en"
retry_limit = 2

# NGROK_AUTHTOKEN is stored in the private secret file, never in this TOML.
[remote_access]
enabled = false
config_file = "~/.config/ninjarobot_pi5/ngrok.yml"
executable = "~/.local/share/ninjarobot_pi5/bin/ngrok"
authtoken_env = "NGROK_AUTHTOKEN"
pairing_secret_env = "NINJAROBOT_PAIRING_SECRET"
session_secret_env = "NINJAROBOT_SESSION_SECRET"
remote_header_secret_env = "NINJAROBOT_REMOTE_HEADER_SECRET"
local_upstream = "https://127.0.0.1:8443"
connect_timeout_seconds = 30.0
retry_initial_seconds = 2.0
retry_max_seconds = 120.0
retry_limit = 10
health_interval_seconds = 30.0
pairing_lifetime_seconds = 300
session_lifetime_seconds = 86400

[onboarding]
enabled = false
qr_error_correction = "M"
qr_border_modules = 4
greeting_behavior = "greeting"
idle_behavior = "idle"
connection_timeout_seconds = 60.0

# The installer changes these only after an explicit operator confirmation.
[deployment]
auto_start_enabled = false
web_poweroff_enabled = false
systemd_unit_name = "ninjarobot-agent.service"
restart_policy = "on-failure"
poweroff_helper = "/usr/libexec/ninjarobot-poweroff"

[providers.ollama]
kind = "ollama"
model = "configured-by-user"
enabled = true
base_url = "http://127.0.0.1:11434"

[providers.openai]
kind = "openai"
model = "gpt-5-mini"
enabled = true
auth_method = "api_key"
api_key_env = "OPENAI_API_KEY"

[providers.gemini]
kind = "gemini"
model = "gemini-2.5-flash"
enabled = true
auth_method = "api_key"
api_key_env = "GEMINI_API_KEY"

[providers.anthropic]
kind = "anthropic"
model = "claude-sonnet-4-5"
enabled = true
auth_method = "api_key"
api_key_env = "ANTHROPIC_API_KEY"
