{
  "schema_version": 1,
  "name": "greeting",
  "description": "Animate a greeting with the happy melody, then show the greeting text.",
  "category": "expression",
  "stages": [
    {
      "name": "greeting_face_and_sound",
      "operations": [
        {
          "kind": "face",
          "expression": "greeting",
          "background": "#000040",
          "foreground": "#FFFFFF",
          "accent": "#FFD700",
          "hold_seconds": 2.0
        },
        {
          "kind": "melody",
          "melody": "happy",
          "volume": 64
        }
      ]
    },
    {
      "name": "greeting_text",
      "operations": [
        {
          "kind": "text",
          "text": "Nice to meet you",
          "font_size": 30,
          "foreground": "#FFFFFF",
          "background": "#000040",
          "hold_seconds": 2.0
        }
      ]
    }
  ]
}
