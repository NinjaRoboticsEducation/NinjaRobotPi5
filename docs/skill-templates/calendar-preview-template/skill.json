{
  "schema_version": 2,
  "id": "calendar-preview-template",
  "version": "1.1.0",
  "name": "Calendar preview template",
  "description": "Calendar preview template with explicit compatibility requirements and no extra permissions.",
  "activation_examples": [
    "Help me understand this feature"
  ],
  "allowed_tools": [
    "calendar.connections",
    "calendar.list_events",
    "calendar.propose_change"
  ],
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "required": [
      "prompt"
    ]
  },
  "requirements": {
    "minimum_agent_version": "1.0.0",
    "required_capabilities": {
      "calendar.connections": "1.0.0",
      "calendar.list_events": "1.0.0",
      "calendar.propose_change": "1.0.0"
    },
    "optional_capabilities": {},
    "effects": [
      "read_only",
      "local_write"
    ]
  }
}
