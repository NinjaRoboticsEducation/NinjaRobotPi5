{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/llmwiki/source-record.schema.json",
  "title": "LLM Wiki source record",
  "type": "object",
  "required": ["id", "path", "media_type", "title", "added_at", "content_hash", "state"],
  "properties": {
    "id": {"type": "string", "pattern": "^src-[a-z0-9][a-z0-9-]*$"},
    "path": {"type": "string", "pattern": "^raw/(articles|papers|notes|media)/"},
    "media_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "added_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "state": {"enum": ["pending", "ingested", "needs-review", "failed"]},
    "original_uri": {"type": ["string", "null"]},
    "source_version": {"type": ["string", "null"]},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "kind": {"enum": ["text", "document", "image"]},
    "image": {
      "type": ["object", "null"],
      "properties": {
        "format": {"enum": ["PNG", "JPEG"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "contains_gps_metadata": {"type": "boolean"},
        "contains_sensitive_metadata": {"type": "boolean"},
        "ocr_status": {"enum": ["off", "unavailable", "completed", "empty", "failed"]},
        "asset_status": {"enum": ["not-published", "published"]}
      },
      "additionalProperties": true
    },
    "normalized_at": {"type": ["string", "null"], "format": "date-time"},
    "normalizer": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
